OPENAI_API_KEY=

# Streamlit → FastAPI
RAG_API_URL=http://127.0.0.1:8000

# FastAPI → Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# 로컬은 자동 GPU 감지 및 cuda, 클라우드 백엔드는 두 값을 cpu로 설정
EMBEDDING_DEVICE=
RERANKER_DEVICE=cuda
RAG_ACTIVE_CONFIG_PATH=configs/active.yaml

# Streamlit Community Cloud에서는 재시작 시 초기화될 수 있는 임시 저장소
CHAT_DB_PATH=data/chat/chat.sqlite3

# 선택 기능: 운영 추적
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
